# Public website runtime environment.
# Copy this file to .env.local for local development.

NEXT_PUBLIC_APP_ENV=development

# Canonical browser URL for SEO metadata, Open Graph URLs, and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-visible API base URL. The app normalizes /api and /api/v1 automatically.
NEXT_PUBLIC_API_BASE_URL=http://0.0.0.0:5000/api/v1

# Server-only API base URL for SSR/SSG fetches. Keep this private; it is not exposed
# to the browser. In production this may be a private upstream such as
# http://127.0.0.1:5000/api/v1 when Next.js and the API run on the same VPS.
API_BASE_URL=http://0.0.0.0:5000/api/v1

# Legacy alias still supported by the codebase. Prefer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_SITE_URL=https://www.astronomypathshala.com
# NEXT_PUBLIC_API_BASE_URL=https://api.astronomypathshala.com/api/v1
# API_BASE_URL=https://api.astronomypathshala.com/api/v1
